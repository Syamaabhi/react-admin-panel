@charset "utf-8";

.b_svcitm { width: 100%; padding: 4px 0px 4px 12px; height: 40px; display: =
-webkit-flex; position: relative; align-items: center; }

.b_svcitm[data-svd=3D"1"] .b_svcimg::after, .b_svcitm:not([data-svd=3D"1"])=
:hover .b_svcimg::after { content: ""; z-index: 2; position: absolute; righ=
t: 0px; display: inline-block; padding: 0px; border-radius: 50%; background=
-size: 34px 42px; background-repeat: no-repeat; background-position: center=
 center; width: 24px; height: 24px; top: 8px; left: 8px; }

.b_svcimg { width: 40px; height: 40px; flex-shrink: 0; display: inline-bloc=
k; border-radius: 4px; border: 0px; position: relative; }

.b_svcitm:nth-child(4n+1) .b_svcimg { background-color: rgb(250, 222, 213);=
 }

.b_svcitm:nth-child(4n+2) .b_svcimg { background-color: rgb(229, 241, 204);=
 }

.b_svcitm:nth-child(4n+3) .b_svcimg { background-color: rgb(205, 237, 252);=
 }

.b_svcitm:nth-child(4n) .b_svcimg { background-color: rgb(255, 241, 204); }

.b_svcimg img { width: 100%; height: 100%; border-radius: 4px; display: non=
e; }

.b_svcimg img[src] { display: block; }

.b_svclnk { display: flex; height: 100%; width: 164px; }

.b_svclnk p { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orie=
nt: vertical; word-break: break-word; overflow-wrap: break-word; font-size:=
 12px; line-height: 16px; max-height: inherit; padding: 0px 0px 0px 12px; m=
argin: auto 0px; overflow: hidden; vertical-align: middle; font-weight: 400=
; }

.b_svcitm:hover .b_svclnk p { max-width: 148px; }

.b_svcimg2 { display: none; }

.b_svcitm:hover .b_svcimg2, .b_svcitm:focus .b_svcimg2 { display: flex; mar=
gin-right: 12px; }

.opnClTgt { width: 16px; height: 16px; margin: auto; background-image: var(=
--opncoltab-img); background-repeat: no-repeat; }

.b_svcimg2:hover, .b_svcimg2:focus { filter: invert(30%) sepia(60%) saturat=
e(4229%) hue-rotate(214deg) brightness(102%) contrast(84%); }

#svctrlpckr { width: 100%; padding: 0px; max-height: 100%; height: 100%; }

#svctrllst, #svctrllstw { width: 100%; padding: 0px; margin: 0px; }

#svctrlpckr #svctrllstw { max-height: 144px; overflow: hidden scroll; }

.b_scactive #svctrlhvrpnl { width: 100%; height: 100%; padding: 0px 0px 4px=
; display: inline-block; }

.b_scactive #svctrlhvrpnllbl { height: 32px; cursor: initial; width: 100%; =
display: flex; margin-top: 8px; }

.b_scactive #svctrlhvrpnlcls { cursor: pointer; padding: 4px; position: abs=
olute; top: 14px; right: 8px; }
